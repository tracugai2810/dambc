{
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/*.json,public/index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/uploads/feedbacks/:filename",
      "destination": "/api/index?__path=/uploads/feedbacks/:filename"
    },
    {
      "source": "/",
      "destination": "/api/index?__path=/"
    }
  ]
}
